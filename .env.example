# AccessiScan AI configuration. Copy to backend/.env (or .env in the project root) and adjust.
# NEVER commit a real .env file. All values below are placeholders.

# --- Core -----------------------------------------------------------------------------------------
ENVIRONMENT=development                # development | production (production enforces secure settings)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# PostgreSQL from docker-compose (Start App scripts fall back to SQLite when Docker is unavailable):
DATABASE_URL=postgresql+psycopg://accessiscan:accessiscan_local_dev@127.0.0.1:55432/accessiscan
# DATABASE_URL=sqlite:///./accessiscan-dev.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXY_HEADERS=false            # true only behind a trusted reverse proxy (Render, nginx)
DOCS_ENABLED=true                      # OpenAPI docs at /api/docs
REGISTRATION_ENABLED=true
EPHEMERAL_DEMO=false                   # true = demo without persistent DB (shows a 'data is temporary' banner)
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- AI (optional) --------------------------------------------------------------------------------
AI_PROVIDER=none                       # none | openai | anthropic | gemini
AI_MODEL=                              # optional override, e.g. gpt-5-mini, claude-sonnet-5-5, gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=1800
AI_DAILY_REQUEST_LIMIT=40              # per user, rolling 24 hours

# --- Scanner limits -------------------------------------------------------------------------------
SCAN_MAX_PAGES=10                      # hard cap 50
SCAN_MAX_DEPTH=2                       # hard cap 5
SCAN_TIMEOUT_SECONDS=300               # whole scan
SCAN_PAGE_TIMEOUT_SECONDS=30
SCAN_MAX_PAGE_MB=15
SCAN_MAX_TOTAL_MB=60
SCAN_MAX_CONCURRENCY=1                 # parallel scans per worker process
SCAN_USER_MAX_ACTIVE=2                 # queued + running scans per user
SCAN_USER_HOURLY_LIMIT=12              # manual scans per user per hour
SCAN_CRAWL_DELAY_MS=1000               # politeness delay between pages
SCAN_ALLOWED_PORTS=80,443,8080,8443
SCAN_MAX_REDIRECTS=10
# Development/test only - "host:port" pairs allowed to resolve to private IPs (e.g. a local test site).
# Refused when ENVIRONMENT=production.
SCANNER_ALLOW_HOSTS=

# --- Background processing ------------------------------------------------------------------------
RUN_EMBEDDED_WORKER=true               # false when running `python -m app.worker` separately
WORKER_POLL_SECONDS=2
WORKER_STALE_MINUTES=15
SCHEDULER_ENABLED=true

# --- Frontend (build time) ------------------------------------------------------------------------
# VITE_API_URL=https://your-api.example.com   # empty = same origin (dev proxy / nginx)
